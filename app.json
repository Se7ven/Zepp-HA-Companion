{
  "configVersion": "v3",
  "app": {
    "appId": 29331,
    "appName": "Zepp HA Companion",
    "appType": "app",
    "version": {
      "code": 4,
      "name": "0.4.0"
    },
    "icon": "icon.png",
    "vender": "Se7ven",
    "description": "Home Assistant companion app for Amazfit smartwatches"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": [
            "page/home/index.page",
            "page/area/index.page"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        },
        {
          "st": "s",
          "dw": 390
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Zepp HA Companion"
    },
    "ru-RU": {
      "appName": "Zepp HA Companion"
    },
    "zh-CN": {
      "appName": "Zepp HA Companion"
    }
  },
  "defaultLanguage": "en-US",
  "debug": false
}
